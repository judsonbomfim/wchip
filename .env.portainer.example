# Configurações do Portainer Stack
# Copie este arquivo e ajuste os valores conforme necessário

# Domínio da aplicação (OBRIGATÓRIO)
DOMAIN=painel2.acasadochip.com.seudominio.com

# Nome da imagem (opcional)
IMAGE_NAME=wchip-web:latest

# ============================================
# CONFIGURAÇÕES DJANGO
# ============================================

# Django Secret Key (OBRIGATÓRIO - Gere uma chave única)
SECRET_KEY=your-secret-key-here

# Debug Mode (use False em produção)
DEBUG=False

# Hosts permitidos (adicione seus domínios)
ALLOWED_HOSTS=wchip.seudominio.com,localhost,127.0.0.1

# Banco de dados
# Ajuste conforme sua configuração de banco
DB_ENGINE=django.db.backends.postgresql
DB_NAME=wchip_db
DB_USER=wchip_user
DB_PASSWORD=your-db-password
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-ou-app-password

# Outras configurações específicas da aplicação
# Adicione aqui outras variáveis que sua aplicação necessita
