# Variáveis da stack Portainer / Compose (interpolação ${...}).
# Copie, ajuste e carregue em Environment variables — não commitar o arquivo real.
#
# Dois arquivos de env no repo:
#   .env             → somente local (DEBUG, hosts de dev). NÃO usar no servidor.
#   .env.production  → conteúdo de produção. No servidor o arquivo se chama .env.
#
# O Django e o Redis leem o mesmo arquivo no host (ENV_FILE_PATH / bind-mount).
# REDIS_PASSWORD só precisa estar nesse .env — não duplique na stack do Portainer.

# Domínio Traefik (OBRIGATÓRIO)
DOMAIN=painel.worldchip.com.br

# Caminho do .env no host (default do servidor atual)
ENV_FILE_PATH=/home/sprdmntrdr/docker/django/.env

# Nome da imagem (opcional)
IMAGE_NAME=djangoweb:latest

# ============================================
# CONFIGURAÇÕES DJANGO
# ============================================

# Django Secret Key (OBRIGATÓRIO — gere uma chave única)
SECRET_KEY=your-secret-key-here

# Deve ser False em produção. settings.py agora lê esta variável.
DEBUG=False

# Hosts permitidos (sem esquema). 127.0.0.1/localhost são adicionados para /healthz/
ALLOWED_HOSTS=painel.worldchip.com.br

# URL pública do painel (com https://) — usada em CSRF e links
URL_PAINEL=https://painel.worldchip.com.br
URL_CDN=cdn.seudominio.com
CSRF_TRUSTED_ORIGINS=https://painel.worldchip.com.br

# Banco de dados (Postgres fica fora deste compose, em shared_backend)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=wchip_db
DB_USER=wchip_user
DB_PASSWORD=your-db-password
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=require

# Redis (opcional: senha na rede interna wchip_internal; recomendado em produção)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-generate-a-long-random-password
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# S3 / static e media (USE_S3 default True)
USE_S3=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_CUSTOM_DOMAIN=

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-ou-app-password
DEFAULT_FROM_EMAIL=seu-email@gmail.com

# WooCommerce
url_site=
consumer_key=
consumer_secret=

# collectstatic no startup (true só no deploy que precisa publicar CSS/JS no S3)
COLLECTSTATIC_ON_STARTUP=false

# API TELCON
APITC_USERNAME=
APITC_PASSWORD=
APITC_HTTPCONN=

# API CHINA MOBILE
APICM_KEY=
APICM_SECRET=
APICM_URL=

# API CMHK
APICMHK_KEY=
APICMHK_SECRET=
APICMHK_URL=

# API TM / VERIZON
APIEO_TOKEN=
APIEO_URL=

# API AIRALO
APIAIRALO_KEY=
APIAIRALO_SECRET=
APIAIRALO_URL=
