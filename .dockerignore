# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches
*.cache/
*.egg-info/
.sass-cache/
.cache/

# Logs
logs/
*.log

# Local configuration
local_settings.py

# Secrets — never bake into image layers
.env
.env.*
!.env.portainer.example

# Virtual environments
env/
venv/
.venv/

# VCS / IDE
.git
.gitignore
.cursor
.idea/
.vscode/

# Theme dumps / backups (not needed at runtime)
templates/inspina_completo
templates/painel_bk

# Node modules
node_modules/

# Static files
staticfiles/

# Media files
media/

# Database
*.sqlite3

# Unit test / coverage reports
htmlcov/
.coverage
.tox/
.pytest_cache/

# OS generated files
.DS_Store
Thumbs.db
